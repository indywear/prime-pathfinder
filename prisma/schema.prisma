generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// =====================
// User & Authentication
// =====================

model User {
  id              String    @id @default(cuid())
  lineUserId      String    @unique
  chineseName     String?
  thaiName        String?
  studentId       String?
  university      String?
  email           String?
  nationality     String?
  gender          String?   // "male" or "female" — for ครับ/ค่ะ particle
  title           String?   // Achievement title (e.g. "จอมคำศัพท์", "เจ้าแห่งไวยากรณ์")
  thaiLevel       ThaiLevel @default(BEGINNER)
  consent         Boolean   @default(false)
  registrationStep Int      @default(0)
  isRegistered    Boolean   @default(false)
  
  // Gamification
  totalPoints     Int       @default(0)
  currentLevel    Int       @default(1)
  lastSpinAt      DateTime?
  
  // Task Progression
  currentTaskWeek    Int       @default(1)  // สัปดาห์ที่ User กำลังจะทำ (ยังไม่ได้ส่ง)

  // Current Game State
  currentGameType    String?
  currentQuestionId  String?
  gameData           String?   @db.Text  // JSON data for game state
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  
  // Relations
  submissions         Submission[]
  feedbackRequests    FeedbackRequest[]
  practiceSessions    PracticeSession[]
  badges              UserBadge[]
  vocabularyProgress  UserVocabulary[]
  writingSubmissions  WritingSubmission[]
  vocabCollections    UserVocabCollection[]
  gameSessions        LanguageGameSession[]
  questionHistory     UserQuestionHistory[]
  lessonProgress      LessonProgress[]
  skillProfiles       UserSkillProfile[]
}

enum ThaiLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// =====================
// Tasks & Assignments
// =====================

model Task {
  id          String   @id @default(cuid())
  weekNumber  Int      @unique
  slug        String   @unique
  title       String
  description String   @db.Text
  contentUrl  String?
  contentHtml String?  @db.Text  // เนื้อหาบทอ่านที่พิมพ์ใน Admin → สร้างหน้าเว็บอัตโนมัติ
  minWords    Int      @default(80)
  maxWords    Int      @default(120)
  deadline    DateTime
  isActive    Boolean  @default(true)

  // Practice Examples (ตัวอย่างคำตอบสำหรับ AI ใช้อ้างอิงตอนตรวจ)
  bestPractice    String?  @db.Text  // ตัวอย่างคำตอบที่ดี
  generalPractice String?  @db.Text  // ตัวอย่างคำตอบระดับกลาง
  badPractice     String?  @db.Text  // ตัวอย่างคำตอบที่ไม่ดี

  // Rubric configuration (JSON)
  rubric      Json     @default("{\"accuracy\": 14, \"contentSelection\": 14, \"interpretation\": 14, \"taskFulfillment\": 14, \"organization\": 14, \"languageUse\": 14, \"mechanics\": 14}")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  submissions      Submission[]
  feedbackRequests FeedbackRequest[]

  @@index([isActive])
}

// =====================
// Submissions
// =====================

model Submission {
  id           String   @id @default(cuid())
  userId       String
  taskId       String
  content      String   @db.Text
  wordCount    Int

  // 7-Criteria Rubric Scores (1-4 each, stored as 0-14 scaled)
  accuracyScore         Int @default(0)  // ความถูกต้อง
  contentSelectionScore Int @default(0)  // การเลือกสาระ
  interpretationScore   Int @default(0)  // การตีความ
  taskFulfillmentScore  Int @default(0)  // การทำตามภารกิจ
  organizationScore     Int @default(0)  // การเรียบเรียง
  languageUseScore      Int @default(0)  // การใช้ภาษา
  mechanicsScore        Int @default(0)  // อักขระวิธี
  totalScore            Int @default(0)  // 0-100
  
  // AI Feedback
  aiFeedback   String?  @db.Text
  
  // Gamification
  pointsEarned Int      @default(0)
  onTime       Boolean  @default(true)
  earlyBonus   Boolean  @default(false)

  // Cheating Detection
  submissionSpeed   Int?      // วินาทีจากเริ่ม→ส่ง
  suspectedAI       Boolean   @default(false)
  suspectedCopy     Boolean   @default(false)
  suspectedFast     Boolean   @default(false)

  submittedAt  DateTime @default(now())
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  @@unique([userId, taskId])
  @@index([userId])
  @@index([taskId])
  @@index([submittedAt])
}

// =====================
// Feedback Requests
// =====================

model FeedbackRequest {
  id           String   @id @default(cuid())
  userId       String
  taskId       String?
  draftContent String   @db.Text
  aiFeedback   String?  @db.Text
  pointsEarned Int      @default(5)
  isRevision   Boolean  @default(false)
  
  requestedAt  DateTime @default(now())
  
  // Relations
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([requestedAt])
}

// =====================
// Practice Sessions
// =====================

model PracticeSession {
  id           String       @id @default(cuid())
  userId       String
  activityType ActivityType
  
  // Questions and answers (JSON arrays)
  questions    Json
  answers      Json
  
  correctCount Int          @default(0)
  totalCount   Int          @default(0)
  pointsEarned Int          @default(0)
  
  completedAt  DateTime     @default(now())
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([activityType])
}

enum ActivityType {
  // Vocabulary Games
  VOCAB_MATCH          // จับคู่คำ
  VOCAB_MEANING        // ความหมายคำศัพท์
  VOCAB_OPPOSITE       // คำตรงข้าม
  VOCAB_SYNONYM        // คำพ้องความหมาย

  // Grammar Games
  FILL_BLANK           // เติมคำ
  FIX_SENTENCE         // แก้ไขประโยค
  ARRANGE_SENTENCE     // เรียงประโยค
  SPEED_GRAMMAR        // Speed Grammar

  // Reading & Writing Games
  READ_ANSWER          // อ่านแล้วตอบ
  COMPOSE_SENTENCE     // แต่งประโยค
  SUMMARIZE            // สรุปเรื่อง
  CONTINUE_STORY       // เขียนต่อเรื่อง

  // Fun Games
  DAILY_VOCAB          // คำศัพท์รายวัน
  RACE_CLOCK           // แข่งกับเวลา
  VOCAB_GACHA          // กาชาคำศัพท์
}

// =====================
// Vocabulary
// =====================

model Vocabulary {
  id              String   @id @default(cuid())
  word            String   @unique
  meaning         String
  meaningChinese  String?
  exampleSentence String?
  difficulty      Difficulty @default(MEDIUM)
  
  createdAt       DateTime @default(now())
  
  // Relations
  userProgress    UserVocabulary[]
  
  @@index([difficulty])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model UserVocabulary {
  userId       String
  vocabularyId String
  correctCount Int      @default(0)
  wrongCount   Int      @default(0)
  lastPracticed DateTime @default(now())
  
  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  
  @@id([userId, vocabularyId])
  @@index([userId])
}

// =====================
// Badges & Achievements
// =====================

model Badge {
  id          String   @id @default(cuid())
  badgeType   String   @unique
  name        String
  nameThai    String
  description String
  iconUrl     String?
  requirement Int      @default(1)
  
  // Relations
  userBadges  UserBadge[]
}

model UserBadge {
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  
  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  
  @@id([userId, badgeId])
  @@index([userId])
}

// =====================
// System Configuration
// =====================

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// =====================
// Chinese-Thai Vocabulary (New Game)
// =====================

model ChineseVocabulary {
  id           String   @id @default(cuid())
  chineseWord  String   @unique
  thaiMeaning  String
  category     String?
  
  createdAt    DateTime @default(now())
  
  @@index([category])
}

// =====================
// Fill-in-Blank Questions
// =====================

model FillBlankQuestion {
  id             String   @id @default(cuid())
  sentence       String   @db.Text
  answer         String
  hint           String?    // คำใบ้ เช่น "คำกริยาเกี่ยวกับการเคลื่อนที่"
  imageUrl       String?    // URL รูปภาพประกอบ
  category       String?
  difficulty     Difficulty @default(MEDIUM)

  createdAt      DateTime @default(now())

  @@index([category])
  @@index([difficulty])
}

// =====================
// Multiple Choice Questions
// =====================

model MultipleChoiceQuestion {
  id             String   @id @default(cuid())
  question       String   @db.Text
  optionA        String
  optionB        String
  optionC        String
  optionD        String
  correctAnswer  String   // A, B, C, or D
  category       String?
  difficulty     Difficulty @default(MEDIUM)

  createdAt      DateTime @default(now())

  @@index([category])
  @@index([difficulty])
}

// =====================
// Sentence Construction Pairs
// =====================

model SentenceConstructionPair {
  id         String     @id @default(cuid())
  word1      String
  word2      String
  category   String?
  difficulty Difficulty @default(MEDIUM)

  createdAt  DateTime   @default(now())

  @@index([category])
  @@index([difficulty])
}

// =====================
// Writing Tasks with Examples
// =====================

model WritingTask {
  id              String   @id @default(cuid())
  taskNumber      Int      @unique
  title           String
  description     String   @db.Text
  bestExample     String   @db.Text
  generalExample  String   @db.Text
  badExample      String   @db.Text
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  submissions     WritingSubmission[]
  
  @@index([taskNumber])
  @@index([isActive])
}

model WritingSubmission {
  id              String   @id @default(cuid())
  userId          String
  writingTaskId   String
  content         String   @db.Text
  
  // 5-Criteria Rubric Scores (1-4 each)
  contentScore       Int   @default(0)
  organizationScore  Int   @default(0)
  grammarScore       Int   @default(0)
  vocabularyScore    Int   @default(0)
  mechanicsScore     Int   @default(0)
  totalScore         Int   @default(0)
  
  // AI Feedback
  aiFeedback      String?  @db.Text
  pointsEarned    Int      @default(0)
  
  submittedAt     DateTime @default(now())
  
  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  writingTask WritingTask  @relation(fields: [writingTaskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([writingTaskId])
  @@index([submittedAt])
}

// =====================
// Vocabulary Match Questions
// =====================

model VocabMatchQuestion {
  id          String     @id @default(cuid())
  word        String
  meaning     String     // คำตอบถูก
  wrongA      String
  wrongB      String
  wrongC      String
  hint        String?    // คำใบ้ เช่น "เกี่ยวกับอาหาร"
  imageUrl    String?    // URL รูปภาพประกอบ
  difficulty  Difficulty @default(MEDIUM)

  createdAt   DateTime   @default(now())

  @@index([difficulty])
}

// =====================
// Vocabulary Opposite Questions
// =====================

model VocabOppositeQuestion {
  id          String     @id @default(cuid())
  word        String
  opposite    String     // คำตอบถูก
  wrongA      String
  wrongB      String
  wrongC      String
  hint        String?    // คำใบ้ เช่น "ตรงข้ามกับคำด้านบวก"
  imageUrl    String?    // URL รูปภาพประกอบ
  difficulty  Difficulty @default(MEDIUM)

  createdAt   DateTime   @default(now())

  @@index([difficulty])
}

// =====================
// Vocabulary Synonym Questions
// =====================

model VocabSynonymQuestion {
  id          String     @id @default(cuid())
  word        String
  synonym     String     // คำตอบถูก
  wrongA      String
  wrongB      String
  wrongC      String
  hint        String?    // คำใบ้ เช่น "คำที่ใช้ในชีวิตประจำวัน"
  imageUrl    String?    // URL รูปภาพประกอบ
  difficulty  Difficulty @default(MEDIUM)

  createdAt   DateTime   @default(now())

  @@index([difficulty])
}

// =====================
// Fix Sentence Questions
// =====================

model FixSentenceQuestion {
  id              String   @id @default(cuid())
  wrongSentence   String   @db.Text
  correctSentence String   @db.Text
  hint            String?
  imageUrl        String?    // URL รูปภาพประกอบ
  difficulty      Difficulty @default(MEDIUM)

  createdAt       DateTime @default(now())

  @@index([difficulty])
}

// =====================
// Arrange Sentence Questions
// =====================

model ArrangeSentenceQuestion {
  id              String   @id @default(cuid())
  shuffledWords   String   @db.Text  // คำที่สลับ คั่นด้วย |
  correctSentence String   @db.Text
  hint            String?    // คำใบ้ เช่น "ประโยคเกี่ยวกับครอบครัว"
  imageUrl        String?    // URL รูปภาพประกอบ
  difficulty      Difficulty @default(MEDIUM)

  createdAt       DateTime @default(now())

  @@index([difficulty])
}

// =====================
// Speed Grammar Questions
// =====================

model SpeedGrammarQuestion {
  id             String   @id @default(cuid())
  question       String   @db.Text
  optionA        String
  optionB        String
  optionC        String
  optionD        String
  correctAnswer  String   // A, B, C, D
  timeLimit      Int      @default(30)  // seconds
  hint           String?    // คำใบ้ เช่น "สังเกตคำเชื่อมในประโยค"
  imageUrl       String?    // URL รูปภาพประกอบ
  difficulty     Difficulty @default(MEDIUM)

  createdAt      DateTime @default(now())

  @@index([difficulty])
}

// =====================
// Read & Answer Questions
// =====================

model ReadAnswerQuestion {
  id            String   @id @default(cuid())
  passage       String   @db.Text
  question      String   @db.Text
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String   // A, B, C, D
  hint          String?    // คำใบ้ เช่น "อ่านย่อหน้าที่ 2"
  imageUrl      String?    // URL รูปภาพประกอบ
  difficulty    Difficulty @default(MEDIUM)

  createdAt     DateTime @default(now())

  @@index([difficulty])
}

// =====================
// Summarize Questions
// =====================

model SummarizeQuestion {
  id            String   @id @default(cuid())
  passage       String   @db.Text
  sampleSummary String   @db.Text
  keywords      String   // คำสำคัญที่ควรมี คั่นด้วย |
  hint          String?    // คำใบ้ เช่น "เน้นใจความสำคัญของเรื่อง"
  imageUrl      String?    // URL รูปภาพประกอบ
  difficulty    Difficulty @default(MEDIUM)

  createdAt     DateTime @default(now())

  @@index([difficulty])
}

// =====================
// Continue Story Questions
// =====================

model ContinueStoryQuestion {
  id            String   @id @default(cuid())
  storyStart    String   @db.Text
  keywords      String   // คำสำคัญที่ควรมี คั่นด้วย |
  minLength     Int      @default(50)
  hint          String?    // คำใบ้ เช่น "ลองใช้คำสำคัญในเรื่อง"
  imageUrl      String?    // URL รูปภาพประกอบ
  difficulty    Difficulty @default(MEDIUM)

  createdAt     DateTime @default(now())

  @@index([difficulty])
}

// =====================
// Daily Vocabulary
// =====================

model DailyVocab {
  id          String   @id @default(cuid())
  word        String
  meaning     String
  example     String   @db.Text
  forDate     DateTime @unique

  createdAt   DateTime @default(now())
}

// =====================
// User Vocab Collection (Gacha)
// =====================

model UserVocabCollection {
  id          String   @id @default(cuid())
  odUserId    String   @map("userId")
  word        String
  meaning     String
  example     String?  @db.Text
  rarity      String   @default("COMMON")  // COMMON, RARE, EPIC, LEGENDARY

  collectedAt DateTime @default(now())

  // Relations
  user User @relation(fields: [odUserId], references: [id], onDelete: Cascade)

  @@unique([odUserId, word])
  @@index([odUserId])
}

// =====================
// Gacha Vocabulary Pool
// =====================

model GachaVocab {
  id          String   @id @default(cuid())
  word        String   @unique
  meaning     String
  rarity      String   @default("COMMON")  // COMMON, RARE, EPIC, LEGENDARY

  createdAt   DateTime @default(now())

  @@index([rarity])
}

// =====================
// User Question History (Track answered questions)
// =====================

model UserQuestionHistory {
  id             String   @id @default(cuid())
  userId         String
  questionId     String   // ID of the question from any game table
  gameType       String   // Which game (VOCAB_MATCH, FILL_BLANK, etc.)
  wasCorrect     Boolean  @default(false)
  attemptNumber  Int      @default(1)  // ครั้งที่เท่าไหร่ที่ตอบข้อนี้
  answeredAt     DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, gameType])
  @@index([userId, questionId, gameType])  // สำหรับนับจำนวน attempt
  @@index([answeredAt])
  @@index([userId, wasCorrect])            // สำหรับ query accuracy
}

// =====================
// User Skill Profile (ติดตาม accuracy รายหมวด)
// =====================

model UserSkillProfile {
  id              String   @id @default(cuid())
  userId          String
  category        String   // "vocabulary", "grammar", "reading", "writing", "culture"
  totalAttempts   Int      @default(0)
  correctAttempts Int      @default(0)
  accuracy        Float    @default(0)   // 0.0 to 1.0
  lastPracticedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

// =====================
// Game Sessions
// =====================

enum GameType {
  // Vocabulary Games
  VOCAB_MATCH          // จับคู่คำ
  VOCAB_MEANING        // ความหมายคำศัพท์
  VOCAB_OPPOSITE       // คำตรงข้าม
  VOCAB_SYNONYM        // คำพ้องความหมาย

  // Grammar Games
  FILL_BLANK           // เติมคำ
  FIX_SENTENCE         // แก้ไขประโยค
  ARRANGE_SENTENCE     // เรียงประโยค
  SPEED_GRAMMAR        // Speed Grammar

  // Reading & Writing Games
  READ_ANSWER          // อ่านแล้วตอบ
  COMPOSE_SENTENCE     // แต่งประโยค
  SUMMARIZE            // สรุปเรื่อง
  CONTINUE_STORY       // เขียนต่อเรื่อง

  // Fun Games
  DAILY_VOCAB          // คำศัพท์รายวัน
  RACE_CLOCK           // แข่งกับเวลา
  VOCAB_GACHA          // กาชาคำศัพท์

  // Culture Games
  THAI_IDIOM           // สำนวนไทย
  THAI_CULTURE         // วัฒนธรรมไทย

  // Legacy Games
  MULTIPLE_CHOICE      // เลือกตอบ (legacy multiple choice)
  SENTENCE_WRITING     // แต่งประโยค (legacy name, same as COMPOSE_SENTENCE)
}

model LanguageGameSession {
  id           String    @id @default(cuid())
  odUserId     String
  gameType     GameType
  
  // Game state
  questions    Json      @default("[]")
  answers      Json      @default("[]")
  currentIndex Int       @default(0)
  isCompleted  Boolean   @default(false)
  
  // Results
  correctCount Int       @default(0)
  totalCount   Int       @default(0)
  pointsEarned Int       @default(0)
  
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  // Relations
  user User @relation(fields: [odUserId], references: [id], onDelete: Cascade)

  @@map("language_game_sessions")
  @@index([odUserId])
  @@index([odUserId, isCompleted])
  @@index([gameType])
  @@index([isCompleted])
}

// =====================
// Lessons (สอนก่อนเล่น)
// =====================

model Lesson {
  id           String   @id @default(cuid())
  category     String   // "vocabulary", "grammar", "reading"
  difficulty   String   @default("EASY") // EASY, MEDIUM, HARD
  orderIndex   Int      @default(0) // ลำดับบทเรียนใน category
  title        String   // ชื่อบทเรียน เช่น "คำสัปท์พื้นฐาน: อาหาร"
  content      String   @db.Text // เนื้อหาหลัก (text/markdown)
  examples     String?  @db.Text // ตัวอย่าง (JSON array หรือ text)
  tips         String?  @db.Text // เคล็ดลับ/เพิ่มเติม
  imageUrl     String?  // รูปภาพประกอบ
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  progress     LessonProgress[]

  @@index([category])
  @@index([category, difficulty])
  @@index([isActive])
}

model LessonProgress {
  id           String   @id @default(cuid())
  userId       String
  lessonId     String
  isCompleted  Boolean  @default(false)
  completedAt  DateTime?
  createdAt    DateTime @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([userId, isCompleted])
}

// =====================
// Thai Idiom Questions (สำนวนไทย)
// =====================

model ThaiIdiomQuestion {
  id          String     @id @default(cuid())
  idiom       String     // สำนวน เช่น "น้ำขึ้นให้รีบตัก"
  meaning     String     // ความหมาย (คำตอบถูก)
  wrongA      String     // ตัวเลือกผิด 1
  wrongB      String     // ตัวเลือกผิด 2
  wrongC      String     // ตัวเลือกผิด 3
  example     String?    @db.Text  // ตัวอย่างการใช้สำนวนในประโยค
  hint        String?    // คำใบ้
  imageUrl    String?    // รูปภาพประกอบ
  difficulty  Difficulty @default(MEDIUM)

  createdAt   DateTime   @default(now())

  @@index([difficulty])
}

// =====================
// Thai Culture Questions (วัฒนธรรม/มารยาทไทย)
// =====================

model ThaiCultureQuestion {
  id          String     @id @default(cuid())
  situation   String     @db.Text  // สถานการณ์ เช่น "เมื่อเดินผ่านผู้ใหญ่ที่นั่งอยู่ ควรทำอย่างไร"
  correct     String     // คำตอบถูก
  wrongA      String     // ตัวเลือกผิด 1
  wrongB      String     // ตัวเลือกผิด 2
  wrongC      String     // ตัวเลือกผิด 3
  explanation String?    @db.Text  // คำอธิบายเพิ่มเติม
  category    String     @default("manners") // manners, taboo, culture, greetings
  hint        String?    // คำใบ้
  imageUrl    String?    // รูปภาพประกอบ
  difficulty  Difficulty @default(MEDIUM)

  createdAt   DateTime   @default(now())

  @@index([difficulty])
  @@index([category])
}
